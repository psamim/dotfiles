+// Magic Mouse touches do not arrive as gesture events, so read them from MultitouchSupport.
+typedef void* MTDeviceRef;
+typedef struct {
+	int frame;
+	double timestamp;
+	int identifier, state, fingerId, handId;
+	float x, y, vx, vy;
+	float size;
+	int zero1;
+	float angle, majorAxis, minorAxis;
+	float absx, absy, absvx, absvy;
+	int zero2[2];
+	float zDensity;
+} MTTouch;
+#define MT_FAMILY_MAGIC_MOUSE 112
+#define MT_STATE_TOUCHING 4
+
+extern CFArrayRef MTDeviceCreateList(void);
+extern void MTRegisterContactFrameCallback(MTDeviceRef, void (*)(MTDeviceRef, MTTouch*, int, double, int));
+extern void MTDeviceStart(MTDeviceRef, int);
+extern void MTDeviceGetFamilyID(MTDeviceRef, int*);
+
+static void mouse_frame(__unused MTDeviceRef dev, MTTouch* mt, int n, double ts, __unused int frame)
+{
+	static float last_x[MAX_TOUCHES];
+	static double last_ts[MAX_TOUCHES];
+	static bool was_touching = false;
+
+	touch buf[MAX_TOUCHES];
+	int count = 0;
+
+	for (int i = 0; i < n && count < MAX_TOUCHES; ++i) {
+		if (mt[i].state != MT_STATE_TOUCHING)
+			continue;
+		int id = mt[i].fingerId % MAX_TOUCHES;
+		double dt = ts - last_ts[id];
+		bool known = last_ts[id] > 0 && dt > 0 && dt < 0.1;
+		buf[count] = (touch) {
+			.x = mt[i].x,
+			.y = mt[i].y,
+			.phase = 0,
+			.timestamp = ts,
+			.velocity = known ? (mt[i].x - last_x[id]) / dt : 0,
+		};
+		last_x[id] = mt[i].x;
+		last_ts[id] = ts;
+		count++;
+	}
+
+	if (!count) {
+		if (was_touching) {
+			memset(last_ts, 0, sizeof(last_ts));
+			was_touching = false;
+			gestureCallback(buf, 0, &g_mouse_config, &g_mouse_ctx);
+		}
+		return;
+	}
+
+	was_touching = true;
+	gestureCallback(buf, count, &g_mouse_config, &g_mouse_ctx);
+}
+
+static void start_mouse(void)
+{
+	CFArrayRef devices = MTDeviceCreateList();
+	for (CFIndex i = 0; devices && i < CFArrayGetCount(devices); ++i) {
+		MTDeviceRef dev = (MTDeviceRef)CFArrayGetValueAtIndex(devices, i);
+		int family = 0;
+		MTDeviceGetFamilyID(dev, &family);
+		if (family != MT_FAMILY_MAGIC_MOUSE)
+			continue;
+		MTRegisterContactFrameCallback(dev, mouse_frame);
+		MTDeviceStart(dev, 0);
+	}
+}
